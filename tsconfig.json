{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "outDir": "out",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "sourceMap": true
    },
    "include": [
        "src/**/*",
        "src/git.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ]
}